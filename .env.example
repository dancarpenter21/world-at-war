# Server bind address. Keep real provider credentials only in an ignored .env file.
BIND_ADDR=0.0.0.0:8000
# Local Docker Compose PostgreSQL. Use URL-safe characters in this secret.
POSTGRES_PASSWORD=development-only-change-me
# Optional for direct runs or an external PostgreSQL server; Compose supplies its own URL.
# DATABASE_URL=postgres://world_at_war:replace-me@127.0.0.1:5432/world_at_war
# Host port published by the Docker Compose Nginx edge proxy.
APP_PORT=8080
# Optional. Set this only when catalog setup needs bearer-token protection.
ADMIN_SETUP_TOKEN=
# Enable for HTTPS deployments; applies to guest and remembered-provider cookies.
COOKIE_SECURE=false
# Exact browser origins allowed for credentialed HTTP and WebSocket access.
# Compose derives localhost origins from APP_PORT when this is empty.
# For a custom hostname, set exact origins such as https://game.example.test.
APP_ALLOWED_ORIGINS=

# Optional. Set these to your local user/group IDs when Docker cannot read the
# cached Space-Track catalog under data/cache/space-track.
HOST_UID=1000
HOST_GID=1000

# Optional browser override when the API is not same-origin proxied through Vite or Compose.
VITE_API_BASE=http://localhost:8000
# Optional map rendering limit (1-60 FPS); the simulation clock is independent.
VITE_MAP_FRAME_RATE=60
# Optional map resolution scale (0.25-1); defaults to native resolution.
VITE_MAP_RESOLUTION_SCALE=1

# Optional alternative to entering credentials in the server settings dialog.
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# Read-only runtime output produced by the explicit space-card-enrich CLI.
SPACE_CARDS_DIR=data/generated/space-cards

# Optional airport-cache overrides. Public OurAirports and FAA sources refresh
# after 24 hours by default. Pin FAA_NASR_APT_URL only for a specific cycle.
AIRPORT_CACHE_DIR=data/cache/airports
AIRPORT_REFRESH_MAX_AGE_SECONDS=86400
FAA_NASR_APT_URL=

# Versioned public-safe radio, platform, message, and queue-policy catalog.
COMMUNICATIONS_CATALOG_PATH=data/communications/catalog.yaml
# PostgreSQL communications archive age limit; 0 keeps history indefinitely.
COMMUNICATIONS_ARCHIVE_RETENTION_DAYS=0
# Append-only per-game C2 message event logs.
NETWORK_EVENT_DIR=var/network-events

# Optional local performance trace. Use a fresh directory for each run.
# Empty disables tracing; traces never include credentials or projection payloads.
PERFORMANCE_TRACE_DIR=

# Optional external game AI runner (Node 22+). These are not browser variables.
# Run: node --env-file=.env web/scripts/agent-runner.mjs
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Free router, or an explicit vendor/model:free ID. Paid fallback is disabled.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_RESPONSE_FORMAT=auto
OPENROUTER_TIMEOUT_MS=25000
OPENROUTER_MIN_INTERVAL_MS=10000
# Direct server: http://127.0.0.1:8000; Compose edge: http://127.0.0.1:8080.
WAW_SERVER_URL=http://127.0.0.1:8000
# Assign External agent in Team & players, then copy its one-time connection token.
WAW_AGENT_TOKEN=
WAW_GAME_ID=
