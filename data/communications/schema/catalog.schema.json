{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-at-war.invalid/schemas/communications/catalog.v1.json",
  "title": "World at War public-safe communications catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "as_of", "sources", "devices", "platforms", "assignments", "messages", "policies"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "as_of": { "type": "string", "format": "date" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "devices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/device" } },
    "platforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/platform" } },
    "assignments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assignment" } },
    "messages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/message" } },
    "policies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/policy" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "retrieved_on", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }, "retrieved_on": { "type": "string", "format": "date" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "band": {
      "type": "object", "additionalProperties": false, "required": ["lower_hz", "upper_hz"],
      "properties": { "lower_hz": { "type": "integer", "minimum": 1 }, "upper_hz": { "type": "integer", "minimum": 2 } }
    },
    "mode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "band", "nominal_bit_rate_bps", "max_range_m", "shared_medium"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "band": { "$ref": "#/$defs/band" },
        "nominal_bit_rate_bps": { "type": "integer", "minimum": 1 }, "max_range_m": { "type": "number", "exclusiveMinimum": 0 },
        "shared_medium": { "type": "boolean" }
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "display_name", "kind", "radio_modes", "queue_capacity_packets", "queue_capacity_bytes", "processing_delay_ns", "confidence", "source_ids", "estimate_rationale"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "display_name": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 },
        "radio_modes": { "type": "array", "items": { "$ref": "#/$defs/mode" } },
        "queue_capacity_packets": { "type": "integer", "minimum": 1 }, "queue_capacity_bytes": { "type": "integer", "minimum": 1 },
        "processing_delay_ns": { "type": "integer", "minimum": 0 },
        "confidence": { "enum": ["official", "manufacturer", "corroborated_public", "estimate"] },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "estimate_rationale": { "type": ["string", "null"] }
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false, "required": ["id", "display_name", "device_ids"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "display_name": { "type": "string", "minLength": 1 }, "device_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } }
    },
    "assignment": {
      "type": "object", "additionalProperties": false, "required": ["entity_name", "platform_profile_id"],
      "properties": { "entity_name": { "type": "string", "minLength": 1 }, "platform_profile_id": { "$ref": "#/$defs/id" } }
    },
    "message": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "family", "display_name", "default_priority", "ttl_hops", "expiry_ticks", "reliable"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "family": { "$ref": "#/$defs/id" }, "display_name": { "type": "string", "minLength": 1 },
        "default_priority": { "type": "integer", "minimum": 0, "maximum": 255 }, "ttl_hops": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "expiry_ticks": { "type": "integer", "minimum": 1 }, "reliable": { "type": "boolean" }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["id", "display_name", "queue_discipline"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "display_name": { "type": "string", "minLength": 1 },
        "queue_discipline": { "enum": ["fifo", "strict_priority", "weighted_fair"] }
      }
    }
  }
}
